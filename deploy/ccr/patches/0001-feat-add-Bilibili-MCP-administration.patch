+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createServer } from "node:http";
+import path from "node:path";
+import test from "node:test";
+
+test("remote HTTP MCP stdio proxy preserves sessions, auth and tool responses", async (t) => {
+  const seen = [];
+  const server = createServer(async (request, response) => {
+    const payload = JSON.parse(await consume(request));
+    seen.push({ authorization: request.headers.authorization, payload, session: request.headers["mcp-session-id"] });
+    const headers = { "content-type": "application/json" };
+    if (payload.method === "initialize") headers["mcp-session-id"] = "session-1";
+    const result = payload.method === "tools/list"
+      ? { tools: [{ name: "extract_bilibili_video", inputSchema: { type: "object" } }] }
+      : payload.method === "tools/call"
+        ? { content: [{ text: "ok", type: "text" }] }
+        : {};
+    response.writeHead(200, headers);
+    response.end(JSON.stringify({ id: payload.id, jsonrpc: "2.0", result }));
+  });
+  try {
+    await listen(server);
+  } catch (error) {
+    if (error?.code === "EPERM" || error?.code === "EACCES") {
+      t.skip(`Local HTTP listen is unavailable: ${error.message}`);
+      return;
+    }
+    throw error;
+  }
+  t.after(() => server.close());
+
+  const address = server.address();
+  assert.ok(address && typeof address === "object");
+  const runtime = path.join(process.cwd(), ".test-dist", "core", "runtime", "remote-http-proxy-mcp.js");
+  const child = spawn(process.execPath, [runtime], {
+    env: {
+      ...process.env,
+      BILIBILI_TEST_TOKEN: "secret-test-token",
+      CCR_REMOTE_MCP_API_KEY_ENV: "BILIBILI_TEST_TOKEN",
+      CCR_REMOTE_MCP_PROTOCOL_VERSION: "2024-11-05",
+      CCR_REMOTE_MCP_REQUEST_TIMEOUT_MS: "5000",
+      CCR_REMOTE_MCP_URL: `http://127.0.0.1:${address.port}/mcp`
+    },
+    stdio: ["pipe", "pipe", "pipe"]
+  });
+  t.after(() => { if (!child.killed) child.kill(); });
+
+  await sendJsonRpc(child, { id: 1, jsonrpc: "2.0", method: "initialize", params: {} });
+  const listed = await sendJsonRpc(child, { id: 2, jsonrpc: "2.0", method: "tools/list", params: {} });
+  const called = await sendJsonRpc(child, {
+    id: 3,
+    jsonrpc: "2.0",
+    method: "tools/call",
+    params: { arguments: { url: "BV1xx411c7mD" }, name: "extract_bilibili_video" }
+  });
+
+  assert.equal(listed.result.tools[0].name, "extract_bilibili_video");
+  assert.equal(called.result.content[0].text, "ok");
+  assert.ok(seen.every((item) => item.authorization === "Bearer secret-test-token"));
+  assert.equal(seen[1].session, "session-1");
+  assert.equal(seen[2].session, "session-1");
+});
+
+function sendJsonRpc(child, payload) {
+  return new Promise((resolve, reject) => {
+    let stdout = Buffer.alloc(0);
+    let stderr = "";
+    const cleanup = () => {
+      clearTimeout(timer);
+      child.stdout.off("data", onStdout);
+      child.stderr.off("data", onStderr);
+      child.off("exit", onExit);
+      child.off("error", onError);
+    };
+    const onStdout = (chunk) => {
+      stdout = Buffer.concat([stdout, Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)]);
+      const parsed = readFrame(stdout);
+      if (parsed) { cleanup(); resolve(parsed); }
+    };
+    const onStderr = (chunk) => { stderr += chunk.toString("utf8"); };
+    const onExit = () => { cleanup(); reject(new Error(`proxy exited: ${stderr}`)); };
+    const onError = (error) => { cleanup(); reject(error); };
+    const timer = setTimeout(() => { cleanup(); reject(new Error(`proxy timeout: ${stderr}`)); }, 5000);
+    child.stdout.on("data", onStdout);
+    child.stderr.on("data", onStderr);
+    child.once("exit", onExit);
+    child.once("error", onError);
+    const body = Buffer.from(JSON.stringify(payload));
+    child.stdin.write(`Content-Length: ${body.byteLength}\r\n\r\n`);
+    child.stdin.write(body);
+  });
+}
+
+function readFrame(buffer) {
+  const headerEnd = buffer.indexOf("\r\n\r\n");
+  if (headerEnd < 0) return undefined;
+  const match = /content-length:\s*(\d+)/i.exec(buffer.subarray(0, headerEnd).toString("utf8"));
+  if (!match) return undefined;
+  const start = headerEnd + 4;
+  const end = start + Number(match[1]);
+  return buffer.length >= end ? JSON.parse(buffer.subarray(start, end).toString("utf8")) : undefined;
+}
+
+function listen(server) {
+  return new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => { server.off("error", reject); resolve(); });
+  });
+}
+
+function consume(request) {
+  return new Promise((resolve, reject) => {
+    let value = "";
+    request.setEncoding("utf8");
+    request.on("data", (chunk) => { value += chunk; });
+    request.on("end", () => resolve(value));
+    request.on("error", reject);
+  });
+}
