@@ -0,0 +1,25 @@
+import { join as pathJoin } from "node:path";
+import type { GatewayMcpServerConfig, GatewayMcpStdioServerConfig } from "@ccr/core/contracts/app";
+
+export function remoteMcpServerForCoreGateway(server: GatewayMcpServerConfig): GatewayMcpStdioServerConfig {
+  if (server.transport === "stdio") return server;
+  return {
+    args: [pathJoin(__dirname, "remote-http-proxy-mcp.js")],
+    command: process.execPath,
+    env: {
+      ELECTRON_RUN_AS_NODE: "1",
+      CCR_REMOTE_MCP_URL: server.url,
+      CCR_REMOTE_MCP_PROTOCOL_VERSION: server.protocolVersion,
+      CCR_REMOTE_MCP_REQUEST_TIMEOUT_MS: String(server.requestTimeoutMs),
+      ...(Object.keys(server.headers).length ? { CCR_REMOTE_MCP_HEADERS_JSON: JSON.stringify(server.headers) } : {}),
+      ...(server.apiKey ? { CCR_REMOTE_MCP_API_KEY: server.apiKey } : {}),
+      ...(server.apiKeyEnv ? { CCR_REMOTE_MCP_API_KEY_ENV: server.apiKeyEnv } : {})
+    },
+    name: server.name,
+    protocolVersion: server.protocolVersion,
+    requestTimeoutMs: server.requestTimeoutMs,
+    startupTimeoutMs: server.startupTimeoutMs,
+    stdioMessageMode: "content-length",
+    transport: "stdio"
+  };
+}
diff --git a/packages/core/src/mcp/remote-http-proxy-mcp.ts b/packages/core/src/mcp/remote-http-proxy-mcp.ts
new file mode 100644
index 0000000..bebab14
--- /dev/null
+++ b/packages/core/src/mcp/remote-http-proxy-mcp.ts
@@ -0,0 +1,181 @@
+type JsonPrimitive = boolean | null | number | string;
+type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+type JsonRpcId = null | number | string;
+type JsonRpcMessage = {
+  error?: { code?: number; message?: string };
+  id?: JsonRpcId;
+  jsonrpc?: string;
+  method?: string;
+  params?: unknown;
+  result?: JsonValue;
+};
+
+const targetUrl = requiredEnv("CCR_REMOTE_MCP_URL");
+const protocolVersion = env("CCR_REMOTE_MCP_PROTOCOL_VERSION") ?? "2024-11-05";
+const requestTimeoutMs = clampInteger(Number(env("CCR_REMOTE_MCP_REQUEST_TIMEOUT_MS")), 1_000, 3_600_000, 120_000);
+const apiKeyEnv = env("CCR_REMOTE_MCP_API_KEY_ENV");
+const directApiKey = env("CCR_REMOTE_MCP_API_KEY");
+const configuredHeaders = readHeaders();
+
+let inputBuffer = Buffer.alloc(0);
+let sessionId = "";
+
+process.stdin.on("data", (chunk) => {
+  inputBuffer = Buffer.concat([inputBuffer, Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)]);
+  void drainInputBuffer().catch((error) => {
+    writeJsonRpc(jsonRpcError(null, -32603, formatError(error)));
+  });
+});
+process.stdin.resume();
+
+async function drainInputBuffer(): Promise<void> {
+  while (true) {
+    const delimiter = contentLengthDelimiter(inputBuffer);
+    if (!delimiter) return;
+    const header = inputBuffer.subarray(0, delimiter.index).toString("utf8");
+    const match = /content-length\s*:\s*(\d+)/i.exec(header);
+    if (!match) {
+      inputBuffer = inputBuffer.subarray(delimiter.index + delimiter.length);
+      writeJsonRpc(jsonRpcError(null, -32600, "Missing or invalid Content-Length header."));
+      continue;
+    }
+    const contentLength = Number(match[1]);
+    const bodyStart = delimiter.index + delimiter.length;
+    const bodyEnd = bodyStart + contentLength;
+    if (inputBuffer.length < bodyEnd) return;
+    const body = inputBuffer.subarray(bodyStart, bodyEnd).toString("utf8");
+    inputBuffer = inputBuffer.subarray(bodyEnd);
+
+    let message: JsonRpcMessage;
+    try {
+      const parsed = JSON.parse(body) as unknown;
+      if (!isRecord(parsed)) throw new Error("JSON-RPC request must be an object.");
+      message = parsed as JsonRpcMessage;
+    } catch (error) {
+      writeJsonRpc(jsonRpcError(null, -32700, `Invalid JSON-RPC request: ${formatError(error)}`));
+      continue;
+    }
+
+    const response = await forward(message);
+    if (response) writeJsonRpc(response);
+  }
+}
+
+async function forward(message: JsonRpcMessage): Promise<JsonRpcMessage | undefined> {
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), requestTimeoutMs);
+  try {
+    const headers: Record<string, string> = {
+      accept: "application/json, text/event-stream",
+      "content-type": "application/json",
+      "mcp-protocol-version": protocolVersion,
+      ...configuredHeaders
+    };
+    if (sessionId) headers["mcp-session-id"] = sessionId;
+    const apiKey = directApiKey ?? (apiKeyEnv ? env(apiKeyEnv) : undefined);
+    if (apiKey && !hasHeader(headers, "authorization")) headers.authorization = `Bearer ${apiKey}`;
+
+    const response = await fetch(targetUrl, {
+      body: JSON.stringify(message),
+      headers,
+      method: "POST",
+      signal: controller.signal
+    });
+    sessionId = response.headers.get("mcp-session-id")?.trim() || sessionId;
+    const text = await response.text();
+    if (!response.ok) {
+      return message.id === undefined
+        ? undefined
+        : jsonRpcError(message.id ?? null, -32603, `Remote MCP endpoint returned HTTP ${response.status}.`);
+    }
+    if (message.id === undefined || !text.trim()) return undefined;
+    const parsed = parseResponse(text, message.id);
+    return parsed ?? jsonRpcError(message.id ?? null, -32603, "Remote MCP endpoint returned an invalid JSON-RPC response.");
+  } catch (error) {
+    if (message.id === undefined) return undefined;
+    return jsonRpcError(message.id ?? null, -32603, formatError(error));
+  } finally {
+    clearTimeout(timeout);
+  }
+}
+
+function parseResponse(text: string, expectedId: JsonRpcId | undefined): JsonRpcMessage | undefined {
+  const trimmed = text.trim();
+  if (!trimmed) return undefined;
+  if (trimmed.startsWith("event:") || trimmed.startsWith("data:")) {
+    const messages: JsonRpcMessage[] = [];
+    for (const block of trimmed.split(/\r?\n\r?\n/)) {
+      const data = block.split(/\r?\n/)
+        .filter((line) => line.startsWith("data:"))
+        .map((line) => line.slice(5).trimStart())
+        .join("\n");
+      const parsed = parseJson(data);
+      if (isRecord(parsed)) messages.push(parsed as JsonRpcMessage);
+    }
+    return messages.find((item) => item.id === expectedId) ?? messages[0];
+  }
+  const parsed = parseJson(trimmed);
+  const messages = Array.isArray(parsed) ? parsed : [parsed];
+  return messages.filter(isRecord).map((item) => item as JsonRpcMessage)
+    .find((item) => item.id === expectedId) ?? messages.find(isRecord) as JsonRpcMessage | undefined;
+}
+
+function readHeaders(): Record<string, string> {
+  const raw = env("CCR_REMOTE_MCP_HEADERS_JSON");
+  const parsed = raw ? parseJson(raw) : undefined;
+  if (!isRecord(parsed)) return {};
+  return Object.fromEntries(Object.entries(parsed).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
+}
+
+function contentLengthDelimiter(buffer: Buffer): { index: number; length: number } | undefined {
+  const crlf = buffer.indexOf("\r\n\r\n");
+  if (crlf >= 0) return { index: crlf, length: 4 };
+  const lf = buffer.indexOf("\n\n");
+  return lf >= 0 ? { index: lf, length: 2 } : undefined;
+}
+
+function writeJsonRpc(message: JsonRpcMessage): void {
+  const body = JSON.stringify(message);
+  process.stdout.write(`Content-Length: ${Buffer.byteLength(body, "utf8")}\r\n\r\n${body}`);
+}
+
+function jsonRpcError(id: JsonRpcId, code: number, message: string): JsonRpcMessage {
+  return { error: { code, message }, id, jsonrpc: "2.0" };
+}
+
+function parseJson(value: string): unknown {
+  try { return JSON.parse(value) as unknown; } catch { return undefined; }
+}
+
+function hasHeader(headers: Record<string, string>, name: string): boolean {
+  return Object.keys(headers).some((key) => key.toLowerCase() === name.toLowerCase());
+}
+
+function requiredEnv(name: string): string {
+  const value = env(name);
+  if (!value) {
+    process.stderr.write(`${name} is required.\n`);
+    process.exit(1);
+  }
+  return value;
+}
+
+function env(name: string): string | undefined {
+  const value = process.env[name]?.trim();
+  return value || undefined;
+}
+
+function clampInteger(value: number, min: number, max: number, fallback: number): number {
+  return Number.isFinite(value) ? Math.min(max, Math.max(min, Math.trunc(value))) : fallback;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function formatError(error: unknown): string {
+  if (error instanceof Error) {
+    return error.name === "AbortError" ? `Remote MCP request timed out after ${requestTimeoutMs}ms.` : error.message;
+  }
+  return String(error);
+}
