+const bilibiliAdminBaseUrl = "http://bilibili-mcp:8080";
+const bilibiliMcpServerName = "bilibili-videoread";
+const bilibiliToolNames = ["extract_bilibili_video", "extract_bilibili_comments", "extract_bilibili_danmaku"];
+
+async function handleBilibiliAdmin(request: BilibiliAdminRequest): Promise<unknown> {
+  switch (request.action) {
+    case "status": return bilibiliAdminFetch("/admin/v1/status");
+    case "settings.get": return bilibiliAdminFetch("/admin/v1/settings");
+    case "settings.put": return bilibiliAdminFetch("/admin/v1/settings", "PUT", request.body);
+    case "login.start": return bilibiliAdminFetch("/admin/v1/login/sessions", "POST", {});
+    case "login.get": return bilibiliAdminFetch(`/admin/v1/login/sessions/${safeBilibiliSessionId(request.sessionId)}`);
+    case "login.cancel": return bilibiliAdminFetch(`/admin/v1/login/sessions/${safeBilibiliSessionId(request.sessionId)}`, "DELETE");
+    case "logout": return bilibiliAdminFetch("/admin/v1/logout", "POST", {});
+    case "cache.get": return bilibiliAdminFetch("/admin/v1/cache");
+    case "cache.clear": return bilibiliAdminFetch("/admin/v1/cache", "DELETE");
+    case "runs": return bilibiliAdminFetch("/admin/v1/runs?limit=50");
+    case "test": return bilibiliAdminFetch("/admin/v1/test", "POST", request.body ?? {});
+    case "mcp.discover": return discoverBilibiliMcpTools();
+    case "provision": return provisionBilibiliFusion(request);
+    default: throw new Error("Unknown Bilibili admin action.");
+  }
+}
+
+function safeBilibiliSessionId(value: string | undefined): string {
+  const normalized = value?.trim() ?? "";
+  if (!/^[A-Za-z0-9_-]{8,100}$/.test(normalized)) throw new Error("Invalid Bilibili login session ID.");
+  return normalized;
+}
+
+async function bilibiliAdminFetch(pathname: string, method = "GET", body?: Record<string, unknown>): Promise<unknown> {
+  const token = process.env.BILIBILI_ADMIN_TOKEN?.trim();
+  if (!token) throw new Error("BILIBILI_ADMIN_TOKEN is not configured in the CCR container.");
+  const response = await fetch(`${bilibiliAdminBaseUrl}${pathname}`, {
+    method,
+    headers: { Authorization: `Bearer ${token}`, ...(body !== undefined ? { "content-type": "application/json" } : {}) },
+    ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
+    signal: AbortSignal.timeout(130000)
+  });
+  const text = await response.text();
+  let value: unknown = {};
+  try { value = text ? JSON.parse(text) : {}; } catch { value = { error: text.slice(0, 500) }; }
+  if (!response.ok) {
+    const message = typeof value === "object" && value && "error" in value ? String((value as { error?: unknown }).error) : `HTTP ${response.status}`;
+    throw new Error(`Bilibili service request failed: ${message}`);
+  }
+  return value;
+}
