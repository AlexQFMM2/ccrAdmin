+
+type BilibiliStatus = {
+  service?: { healthy?: boolean; version?: string };
+  login?: { logged_in?: boolean; account?: { mid?: number; uname?: string } | null; remaining_days?: number | null };
+  cache?: { entries?: number; bytes?: number };
+  tools?: string[];
+};
+type BilibiliLoginSession = {
+  id: string;
+  status: string;
+  qr_png?: string;
+  error?: string;
+  account?: { mid?: number; uname?: string } | null;
+};
+type BilibiliRun = {
+  caller?: string;
+  operation?: string;
+  video_id?: string;
+  ok?: number;
+  cache_hit?: number;
+  duration_ms?: number;
+  error?: string | null;
+  created_at?: number;
+};
+
+function BilibiliSettingsPage({ providers }: { providers: GatewayProviderConfig[] }) {
+  const [status, setStatus] = useState<BilibiliStatus>();
+  const [settings, setSettings] = useState<Record<string, number>>({});
+  const [session, setSession] = useState<BilibiliLoginSession>();
+  const [runs, setRuns] = useState<BilibiliRun[]>([]);
+  const [testUrl, setTestUrl] = useState("");
+  const [testOutput, setTestOutput] = useState("");
+  const [fusionAlias, setFusionAlias] = useState("bilibili-reader");
+  const modelOptions = useMemo(() => createRouteModelOptions(providers), [providers]);
+  const preferredModel = modelOptions.find((item) => item.value.includes("deepseek-v4-flash"))?.value ?? modelOptions[0]?.value ?? "deepseek-v4-flash";
+  const [baseModel, setBaseModel] = useState(preferredModel);
+  const [busy, setBusy] = useState("");
+  const [message, setMessage] = useState("");
+
+  const call = async (request: Parameters<NonNullable<typeof window.ccr>["bilibiliAdmin"]>[0]) => {
+    if (!window.ccr?.bilibiliAdmin) throw new Error("Bilibili management RPC is unavailable.");
+    return window.ccr.bilibiliAdmin(request);
+  };
+  const refresh = async () => {
+    setBusy("refresh"); setMessage("");
+    try {
+      const [nextStatus, nextSettings, nextRuns] = await Promise.all([
+        call({ action: "status" }), call({ action: "settings.get" }), call({ action: "runs" })
+      ]);
+      setStatus(nextStatus as BilibiliStatus);
+      setSettings(nextSettings as Record<string, number>);
+      setRuns(((nextRuns as { runs?: BilibiliRun[] }).runs ?? []).slice(0, 50));
+    } catch (error) { setMessage(String(error)); }
+    finally { setBusy(""); }
+  };
+  useEffect(() => { void refresh(); }, []);
+  useEffect(() => {
+    if (!session || !["pending", "scanned"].includes(session.status)) return;
+    const timer = window.setInterval(() => {
+      void call({ action: "login.get", sessionId: session.id })
+        .then((value) => {
+          const next = value as BilibiliLoginSession;
+          setSession(next);
+          if (next.status === "succeeded") void refresh();
+        })
+        .catch((error) => setMessage(String(error)));
+    }, 2000);
+    return () => window.clearInterval(timer);
+  }, [session?.id, session?.status]);
+
+  const run = async (name: string, action: () => Promise<void>) => {
+    setBusy(name); setMessage("");
+    try { await action(); } catch (error) { setMessage(String(error)); }
+    finally { setBusy(""); }
+  };
+  const settingFields = [
+    ["metadata_ttl_seconds", "元数据缓存秒数"], ["subtitle_ttl_seconds", "字幕缓存秒数"],
+    ["comments_ttl_seconds", "评论缓存秒数"], ["danmaku_ttl_seconds", "弹幕缓存秒数"],
+    ["default_max_pages", "默认分 P 数"], ["max_pages", "分 P 硬上限"],
+    ["max_subtitle_chars", "字幕最大字符"], ["default_comments", "默认评论数"],
+    ["max_comments", "评论硬上限"], ["default_danmaku", "默认弹幕数"],
+    ["max_danmaku", "弹幕硬上限"], ["upstream_timeout_seconds", "上游请求超时秒数"],
+    ["task_timeout_seconds", "任务总超时秒数"], ["global_concurrency", "全局并发"],
+    ["rate_limit_requests", "每窗口 Token 请求数"], ["rate_limit_window_seconds", "限流窗口秒数"],
+    ["cache_max_mb", "缓存上限 MiB"]
+  ];
+
+  return <div className={settingsPageContentWidthClassName}>
+    <div className="mb-5 flex items-center justify-between">
+      <div><h2 className="text-lg font-semibold">Bilibili MCP</h2><p className="text-sm text-muted-foreground">管理独立视频读取服务、登录态、缓存与 Fusion 模型。</p></div>
+      <Button disabled={Boolean(busy)} onClick={() => void refresh()} variant="outline"><RefreshCw className="h-4 w-4" />刷新</Button>
+    </div>
+    {message ? <div className="mb-4 rounded-md border border-destructive/30 bg-destructive/5 p-3 text-sm text-destructive">{message}</div> : null}
+    <div className="grid gap-4 sm:grid-cols-3">
+      <div className="rounded-lg border p-4"><div className="text-xs text-muted-foreground">服务</div><div className="mt-1 font-medium">{status?.service?.healthy ? "运行正常" : "不可用"}</div><div className="text-xs text-muted-foreground">v{status?.service?.version ?? "-"}</div></div>
+      <div className="rounded-lg border p-4"><div className="text-xs text-muted-foreground">B站账号</div><div className="mt-1 font-medium">{status?.login?.logged_in ? status.login.account?.uname || status.login.account?.mid : "未登录"}</div><div className="text-xs text-muted-foreground">{status?.login?.remaining_days == null ? "" : `约剩 ${status.login.remaining_days} 天`}</div></div>
+      <div className="rounded-lg border p-4"><div className="text-xs text-muted-foreground">缓存</div><div className="mt-1 font-medium">{status?.cache?.entries ?? 0} 条</div><div className="text-xs text-muted-foreground">{Math.round((status?.cache?.bytes ?? 0) / 1024)} KiB</div></div>
+    </div>
+
+    <div className="mt-5 rounded-lg border p-4">
+      <div className="flex items-center justify-between"><h3 className="font-medium">扫码登录</h3><div className="flex gap-2">
+        <Button disabled={Boolean(busy)} onClick={() => void run("login", async () => setSession(await call({ action: "login.start" }) as BilibiliLoginSession))}>生成二维码</Button>
+        <Button disabled={Boolean(busy) || !status?.login?.logged_in} onClick={() => void run("logout", async () => { await call({ action: "logout" }); setSession(undefined); await refresh(); })} variant="outline">退出登录</Button>
+      </div></div>
+      {session ? <div className="mt-4 flex flex-wrap items-center gap-4">{session.qr_png ? <img alt="Bilibili login QR code" className="h-52 w-52 rounded border bg-white p-2" src={session.qr_png} /> : null}<div><div>状态：{session.status}</div>{session.error ? <div className="text-sm text-destructive">{session.error}</div> : null}{["pending", "scanned"].includes(session.status) ? <Button className="mt-2" onClick={() => void run("cancel", async () => { await call({ action: "login.cancel", sessionId: session.id }); setSession({ ...session, status: "cancelled", qr_png: "" }); })} variant="outline">取消</Button> : null}</div></div> : null}
+    </div>
+
+    <div className="mt-5 rounded-lg border p-4"><h3 className="mb-3 font-medium">读取限制与缓存</h3><div className="grid gap-3 sm:grid-cols-2">
+      {settingFields.map(([key, label]) => <Field key={key} label={label}><Input type="number" value={settings[key] ?? ""} onChange={(event) => setSettings((current) => ({ ...current, [key]: Number(event.target.value) }))} /></Field>)}
+    </div><div className="mt-4 flex gap-2"><Button disabled={Boolean(busy)} onClick={() => void run("save", async () => { setSettings(await call({ action: "settings.put", body: settings }) as Record<string, number>); setMessage("设置已保存"); })}>保存设置</Button><Button disabled={Boolean(busy)} onClick={() => void run("clear", async () => { await call({ action: "cache.clear" }); await refresh(); })} variant="outline">清空缓存</Button></div></div>
+
+    <div className="mt-5 rounded-lg border p-4"><h3 className="mb-3 font-medium">提取测试</h3><div className="flex gap-2"><Input placeholder="BV / AV / Bilibili 链接" value={testUrl} onChange={(event) => setTestUrl(event.target.value)} /><Button disabled={Boolean(busy) || !testUrl.trim()} onClick={() => void run("test", async () => { const output = JSON.stringify(await call({ action: "test", body: { url: testUrl, include: ["metadata", "subtitles"] } }), null, 2); setTestOutput(output.length > 20000 ? `${output.slice(0, 20000)}\n…页面预览已截断` : output); await refresh(); })}>测试</Button></div>{testOutput ? <Textarea className="mt-3 min-h-48 font-mono text-xs" readOnly value={testOutput} /> : null}</div>
+
+    <div className="mt-5 rounded-lg border p-4"><h3 className="mb-3 font-medium">MCP 与 Fusion</h3><div className="grid gap-3 sm:grid-cols-2"><Field label="Fusion 别名"><Input value={fusionAlias} onChange={(event) => setFusionAlias(event.target.value)} /></Field><Field label="基础模型"><SelectControl options={modelOptions} value={baseModel} onChange={setBaseModel} /></Field></div><div className="mt-4 flex gap-2"><Button disabled={Boolean(busy)} onClick={() => void run("discover", async () => setMessage(`发现 ${((await call({ action: "mcp.discover" })) as unknown[]).length} 个 MCP 工具`))} variant="outline">发现工具</Button><Button disabled={Boolean(busy) || !baseModel} onClick={() => void run("provision", async () => { await call({ action: "provision", baseModel, fusionAlias }); setMessage(`Fusion 模型 ${fusionAlias} 已创建或更新`); })}>创建/更新 Fusion</Button></div></div>
+    <div className="mt-5 rounded-lg border p-4"><h3 className="mb-3 font-medium">最近调用与错误</h3>{runs.length ? <div className="space-y-2">{runs.slice(0, 20).map((item, index) => <div className="rounded border p-2 text-xs" key={`${item.created_at ?? 0}-${index}`}><div className="flex flex-wrap justify-between gap-2"><span>{item.ok ? "成功" : "失败"} · {item.caller ?? "-"} · {item.video_id || "未识别视频"}</span><span>{item.duration_ms ?? 0} ms · {item.cache_hit ? "缓存命中" : "实时读取"}</span></div>{item.error ? <div className="mt-1 text-destructive">{item.error}</div> : null}</div>)}</div> : <p className="text-sm text-muted-foreground">暂无调用记录。</p>}</div>
+  </div>;
+}
